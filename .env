APP_NAME="CRICEXPERTS"
APP_ENV=production
APP_KEY=base64:k9JqOeiiuL6UYgdFWBMa8VAUooMB4h+QcYdK/+U1Zkw=
APP_DEBUG=false
# Note: On Hostinger Live domains, AppServiceProvider automatically detects your https://domain.com URL
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=10

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# =====================================================================
# DATABASE CONFIGURATION (Works out-of-the-box on Hostinger with SQLite)
# =====================================================================
DB_CONNECTION=sqlite
DB_JOURNAL_MODE=DELETE
# Uses database/database.sqlite (auto-restored from database/data/initial_database.sqlite on first deploy)

# Optional: If you want to use Hostinger MySQL instead of SQLite, uncomment below and comment DB_CONNECTION=sqlite:
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=u123456789_winbook24
# DB_USERNAME=u123456789_admin
# DB_PASSWORD=your_hostinger_mysql_password

# =====================================================================
# SESSION, CACHE & QUEUE (Optimized for Hostinger Shared/Cloud Hosting)
# =====================================================================
SESSION_DRIVER=file
SESSION_LIFETIME=1440
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync
CACHE_STORE=file

# =====================================================================
# SMS OTP CONFIGURATION (MSG91 / Fast2SMS - Can also be managed in /admin/settings)
# =====================================================================
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=WINB24
MSG91_COUNTRY_CODE=91
MSG91_SANDBOX_SHOW_OTP=true

# =====================================================================
# CUSTOMER SUPPORT & WALLET DEFAULTS
# =====================================================================
SUPPORT_WHATSAPP=+919831391470
WELCOME_BONUS_PTI=0.00
DEMO_BALANCE_PTI=10000.00

# =====================================================================
# SPORTMONKS LIVE SCORE API (Football v3, Cricket v2 & Formula 1 v1)
# =====================================================================
SPORTMONKS_API_TOKEN=
SPORTMONKS_FOOTBALL_URL=https://api.sportmonks.com/v3/football
SPORTMONKS_CRICKET_URL=https://cricket.sportmonks.com/api/v2.0
SPORTMONKS_F1_URL=https://f1.sportmonks.com/api/v1.0
