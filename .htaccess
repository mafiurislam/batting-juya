DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. Redirect legacy static HTML files directly to dynamic Laravel routes
    RewriteRule ^index\.html$ /home [R=301,L]
    RewriteRule ^inplay\.html$ /inplay [R=301,L]
    RewriteRule ^livecasino\.html$ /livecasino [R=301,L]
    RewriteRule ^fullMarket\.html$ /home [R=301,L]

    # 2. Block direct public access to sensitive files and directories
    RewriteRule ^(\.env|\.git|artisan|composer\.(json|lock)|package(-lock)?\.json|phpunit\.xml|README\.md|AGENTS\.md) - [F,L,NC]
    RewriteRule \.(sqlite|sqlite3|log|sh|sql|bak)$ - [F,L,NC]
    RewriteRule ^(app|bootstrap|config|database|resources|routes|storage|tests|vendor)(/|$) - [F,L,NC]

    # 3. Preserve Authorization & X-XSRF-Token Headers
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # 4. If static asset file physically exists in root (e.g. favicon.ico, robots.txt), serve directly
    RewriteCond %{REQUEST_URI} !^/(index\.php)?$
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # 5. Route everything else through Front Controller (index.php)
    RewriteRule ^ index.php [L,QSA]
</IfModule>

# Extra protection for sensitive files
<FilesMatch "^(\.env|\.git|composer\.(json|lock)|artisan|.*\.sqlite.*)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
